<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>*{box-sizing:border-box}body{margin:0;font:13px Tahoma,Verdana,sans-serif;background:radial-gradient(circle at 30% 10%,#fff 0,#dbeeff 35%,#94bfe8 100%);color:#123}.shell{width:min(1000px,96vw);height:min(720px,94vh);margin:3vh auto;border:1px solid #174b86;border-radius:14px;overflow:hidden;box-shadow:0 18px 55px #1c4e8066;background:#f7fbff}.titlebar{height:48px;padding:7px 12px;color:white;background:linear-gradient(#4aa2ed,#0a61b8 55%,#06498e);display:flex;align-items:center;gap:10px}.orb{width:30px;height:30px;border-radius:50%;background:linear-gradient(145deg,#b9ff91,#49a61e);border:2px solid white}.titlebar strong{font-size:17px}.winbtns{margin-left:auto;display:flex;gap:4px}.winbtns i{width:22px;height:18px;border:1px solid #dcefff;border-radius:3px;background:linear-gradient(#fff8,#0c5aaa)}.layout{height:calc(100% - 48px);display:grid;grid-template-columns:220px 1fr}.contacts{border-right:1px solid #6c9fd5;background:linear-gradient(90deg,#eef7ff,#d9ecff)}.profile{padding:14px 12px;border-bottom:1px solid #94b8dd}.avatar{width:52px;height:52px;border:3px solid white;outline:1px solid #85a9cd;border-radius:8px;background:linear-gradient(135deg,#94cfff,#2c6cb3);display:grid;place-items:center;color:#fff;font-size:28px;float:left;margin-right:10px}.status{color:#368509}.tiny{font-size:11px;color:#59728c}.contact-title{padding:12px 10px 6px;font-weight:bold;color:#174b86}.user{padding:7px 10px;display:flex;gap:8px;align-items:center}.dot{width:11px;height:11px;border-radius:50%;background:#59ca25;border:1px solid white;box-shadow:0 0 0 1px #777}.off{background:#aaa}.chat{display:grid;grid-template-rows:66px 1fr 95px;background:white}.buddybar{padding:10px 14px;background:linear-gradient(#fff,#e6f2fc);border-bottom:1px solid #8cb4dd}.buddybar b{font-size:16px;color:#174b86}.messages{overflow:auto;padding:15px;background:linear-gradient(#fff,#f2f8fe)}.msg{max-width:75%;margin:0 0 12px}.msg.me{margin-left:auto;text-align:right}.who{font-size:11px;color:#577795;margin-bottom:3px}.bubble{display:inline-block;text-align:left;padding:9px 12px;border:1px solid #8eb8de;border-radius:5px 13px 13px 13px;background:linear-gradient(#fff,#e8f3fc);box-shadow:0 2px 4px #2b5f8a22}.me .bubble{border-radius:13px 5px 13px 13px;background:linear-gradient(#f5ffe9,#d9f4bd);border-color:#9abf72}.composer{padding:9px;background:linear-gradient(#e8f3fc,#cddff1);border-top:1px solid #87acd0;display:grid;grid-template-columns:1fr 94px;gap:8px}.composer textarea{resize:none;border:1px solid #6e9bc8;border-radius:5px;padding:9px;font:13px Tahoma}.send{border:1px solid #0a4b8e;border-radius:7px;color:white;font-weight:bold;background:linear-gradient(#68b5f1,#0b69c4 60%,#07509a);cursor:pointer}.toast{position:fixed;right:25px;bottom:25px;padding:14px 18px;border:1px solid #245c94;border-radius:9px;background:linear-gradient(#fff,#ddecfa);box-shadow:0 8px 24px #174b8666;display:none}@media(max-width:700px){.layout{grid-template-columns:1fr}.contacts{display:none}.shell{height:100vh;width:100vw;margin:0;border-radius:0}}</style></head><body><div class="shell"><div class="titlebar"><span class="orb"></span><strong>RetroTalk 2000</strong><span>• Chat interno</span><div class="winbtns"><i></i><i></i><i></i></div></div><div class="layout"><aside class="contacts"><div class="profile"><div class="avatar">☺</div><b>Fernando</b><div class="status">● Disponible</div><div class="tiny">Trabajando con nostalgia</div><div style="clear:both"></div></div><div class="contact-title">Contactos</div><div class="user"><i class="dot"></i>Laura</div><div class="user"><i class="dot"></i>Equipo Formación</div><div class="user"><i class="dot off"></i>Soporte</div></aside><main class="chat"><div class="buddybar"><b>Sala general</b><div class="tiny">Los mensajes se guardan en Google Sheets • actualización automática</div><button id="notify" style="float:right;margin-top:-25px">Activar avisos</button></div><div id="messages" class="messages"><div class="msg"><div class="who">Laura · 09:31</div><div class="bubble">¡Hola! Bienvenido al chat retro 👋</div></div><div class="msg me"><div class="who">Fernando · 09:32</div><div class="bubble">Funciona genial. Parece 2003 otra vez.</div></div></div><div class="composer"><textarea id="text" placeholder="Escribe un mensaje…"></textarea><button id="send" class="send">Enviar</button></div></main></div></div><div id="toast" class="toast"></div><script>const text=document.getElementById('text'),messages=document.getElementById('messages'),toast=document.getElementById('toast');function send(){if(!text.value.trim())return;const d=document.createElement('div');d.className='msg me';d.innerHTML='<div class="who">Fernando · ahora</div><div class="bubble"></div>';d.querySelector('.bubble').textContent=text.value;messages.appendChild(d);text.value='';messages.scrollTop=messages.scrollHeight}document.getElementById('send').onclick=send;text.onkeydown=e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();send()}};document.getElementById('notify').onclick=()=>{toast.textContent='Avisos de RetroTalk activados';toast.style.display='block';setTimeout(()=>toast.style.display='none',2500)}</script></body></html>
